# Sao chép thành .env rồi điền. File .env thật KHÔNG được commit.

# --- Khoá của các hãng (chỉ cần khi đổi provider) ---
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Cổng HTTP (api.py) ---
# BẮT BUỘC đặt trước khi mở ra Internet. Rỗng = /chat không cần xác thực.
SEATECCO_API_KEY=
SEATECCO_RATE_LIMIT=20                  # lượt/phút mỗi khoá hoặc mỗi IP; 0 = tắt

# Lịch sử hội thoại do BROWSER giữ và gửi kèm mỗi request; service không giữ gì.
# Ba mức cắt dưới đây là để client không đẩy được context phình lên.
# SEATECCO_HISTORY_MAX_TURNS=8          # số lượt gần nhất được giữ
# SEATECCO_HISTORY_MAX_CHARS=500        # cắt mỗi lượt còn bấy nhiêu ký tự
# SEATECCO_HISTORY_MAX_TOKENS=1200      # chặn lần cuối bằng trim_messages

# Chỉ dùng trong container: Ollama là service khác, và gốc repo là /app
# OLLAMA_BASE_URL=http://ollama:11434
# SEATECCO_ROOT=/app

# --- Quan sát (tùy chọn) ---
# Bật trace lên LangSmith. Để "false" khi chạy eval hoặc khi mạng chậm:
# mỗi lời gọi sẽ chờ tối đa 10s cho GET /info rồi mới chạy tiếp.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=stc-rag-agent

# --- Model (đều có mặc định trong src/seatecco_rag/config.py) ---
# SEATECCO_LLM_PROVIDER=google_genai    # ollama | openai | anthropic | google_genai
# SEATECCO_EMBED_PROVIDER=google_genai  # đổi cái này là PHẢI dựng lại index
# SEATECCO_EMBED_MODEL=gemini-embedding-001   # bản -2 mới hơn nhưng đo được là KÉM hơn
# SEATECCO_LLM_MAX_RETRIES=1            # provider tự retry khi 429/5xx
# SEATECCO_LLM_TIMEOUT=15               # giây MỖI lượt gọi; xấu nhất là
#                                       # (1+MAX_RETRIES)*TIMEOUT rồi mới fallback

# Phao dự bị, CHỈ api.py dùng (eval không bật, kẻo điểm đo thành vô nghĩa).
# Để trống là tắt hẳn.
# SEATECCO_LLM_FALLBACK_PROVIDER=google_genai
# SEATECCO_LLM_FALLBACK_MODEL=gemini-3.6-flash   # model KHÁC model chính:
#                                       # free tier tính hạn mức theo từng model
# SEATECCO_LLM_MODEL=gemini-3.5-flash-lite
# SEATECCO_LLM_NUM_CTX=16384            # chỉ Ollama dùng
# SEATECCO_LLM_NUM_PREDICT=1500
# SEATECCO_LLM_TEMPERATURE=0
# SEATECCO_EMBED_MODEL=gemini-embedding-001
# SEATECCO_EMBED_NUM_CTX=2048          # chỉ Ollama dùng
# SEATECCO_KEEP_ALIVE=1800              # chỉ Ollama dùng

# --- Truy xuất ---
# SEATECCO_SEARCH_K=6            # số chunk đưa cho model
# SEATECCO_SEARCH_CANDIDATES=12  # lấy dư rồi lọc trùng còn K

# Ghi chú: NIMBLE_API_KEY và LANGGRAPH_API_KEY trong .env cũ không còn dùng nữa
# (NimbleToolkit và deepagents đã bị bỏ khỏi đường chạy chính).
