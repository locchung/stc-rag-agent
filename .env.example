# Sao chép thành .env rồi điền. File .env thật KHÔNG được commit.

# --- Khoá của các hãng (chỉ cần khi đổi provider) ---
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Quan sát (tùy chọn) ---
# Bật trace lên LangSmith. Để "false" khi chạy eval hoặc khi mạng chậm:
# mỗi lời gọi sẽ chờ tối đa 10s cho GET /info rồi mới chạy tiếp.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=stc-rag-agent

# --- Model (đều có mặc định trong src/seatecco_rag/config.py) ---
# SEATECCO_LLM_PROVIDER=ollama          # ollama | openai | anthropic | google_genai
# SEATECCO_EMBED_PROVIDER=ollama        # đổi cái này là PHẢI dựng lại index
# SEATECCO_LLM_MAX_RETRIES=1            # provider tự retry khi 429/5xx
# SEATECCO_LLM_TIMEOUT=15               # giây MỖI lượt gọi; xấu nhất là
#                                       # (1+MAX_RETRIES)*TIMEOUT rồi mới fallback

# Phao dự bị, CHỈ api.py dùng (eval không bật, kẻo điểm đo thành vô nghĩa).
# Để trống là tắt hẳn.
# SEATECCO_LLM_FALLBACK_PROVIDER=ollama
# SEATECCO_LLM_FALLBACK_MODEL=qwen3.5:2b
# SEATECCO_LLM_MODEL=qwen3.5:2b
# SEATECCO_LLM_NUM_CTX=16384
# SEATECCO_LLM_NUM_PREDICT=1500
# SEATECCO_LLM_TEMPERATURE=0
# SEATECCO_EMBED_MODEL=qwen3-embedding:0.6b
# SEATECCO_EMBED_NUM_CTX=2048
# SEATECCO_KEEP_ALIVE=1800

# --- Truy xuất ---
# SEATECCO_SEARCH_K=6            # số chunk đưa cho model
# SEATECCO_SEARCH_CANDIDATES=12  # lấy dư rồi lọc trùng còn K

# Ghi chú: NIMBLE_API_KEY và LANGGRAPH_API_KEY trong .env cũ không còn dùng nữa
# (NimbleToolkit và deepagents đã bị bỏ khỏi đường chạy chính).
